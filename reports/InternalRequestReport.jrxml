<?xml version="1.0" encoding="UTF-8"?>
<!-- Created for iDempiere 13 (JasperReports 6.x Compatible) -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="InternalRequestReport" 
              pageWidth="842" 
              pageHeight="595" 
              orientation="Landscape" 
              columnWidth="802" 
              leftMargin="20" 
              rightMargin="20" 
              topMargin="20" 
              bottomMargin="20" 
              whenNoDataType="AllSectionsNoDetail"
              uuid="a4b3c2d1-e5f6-4789-a012-3456789abcde">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="NO_DATA_ADAPTER"/>
	
	<!-- Parâmetros de Contexto do iDempiere -->
	<parameter name="AD_CLIENT_ID" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="AD_Client_ID" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="AD_ORG_ID" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="AD_Org_ID" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="AD_USER_ID" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="AD_User_ID" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="AD_PINSTANCE_ID" class="java.lang.Integer" isForPrompting="false"/>
	
	<!-- Parâmetros de Filtro do Usuário -->
	<parameter name="DateRequested1" class="java.sql.Timestamp"/>
	<parameter name="DateRequested2" class="java.sql.Timestamp"/>
	<parameter name="RequestType" class="java.lang.String"/>
	<parameter name="Priority" class="java.lang.String"/>
	<parameter name="Status" class="java.lang.String"/>
	<parameter name="AssignedTo_ID" class="java.lang.Integer"/>

	<!-- Consulta SQL com decodificação amigável e filtros dinâmicos com CAST explícito -->
	<queryString>
		<![CDATA[
		SELECT 
		    r.XX_InternalRequest_ID,
		    r.DocumentNo,
		    r.DateRequested,
		    r.DateNeeded,
		    r.DateResolved,
		    r.RequestType,
		    CASE r.RequestType
		        WHEN 'IT' THEN 'TI'
		        WHEN 'HR' THEN 'Recursos Humanos'
		        WHEN 'MN' THEN 'Manutenção'
		        WHEN 'OT' THEN 'Outro'
		        ELSE COALESCE(r.RequestType, '-')
		    END AS requesttype_name,
		    r.Priority,
		    CASE r.Priority
		        WHEN 'U' THEN '1 - Urgente'
		        WHEN 'H' THEN '2 - Alta'
		        WHEN 'M' THEN '3 - Média'
		        WHEN 'L' THEN '4 - Baixa'
		        ELSE COALESCE(r.Priority, '-')
		    END AS priority_name,
		    r.Status,
		    CASE r.Status
		        WHEN 'OP' THEN 'Aberta'
		        WHEN 'IP' THEN 'Em Andamento'
		        WHEN 'RS' THEN 'Resolvida'
		        WHEN 'CN' THEN 'Cancelada'
		        ELSE COALESCE(r.Status, '-')
		    END AS status_name,
		    COALESCE(r.Description, '') AS description,
		    COALESCE(req.Name, 'Não Informado') AS requestedby_name,
		    COALESCE(ass.Name, 'Não Atribuído') AS assignedto_name,
		    org.Name AS org_name,
		    cl.Name AS client_name
		FROM XX_InternalRequest r
		INNER JOIN AD_Client cl ON cl.AD_Client_ID = r.AD_Client_ID
		INNER JOIN AD_Org org ON org.AD_Org_ID = r.AD_Org_ID
		LEFT JOIN AD_User req ON req.AD_User_ID = r.RequestedBy_ID
		LEFT JOIN AD_User ass ON ass.AD_User_ID = r.AssignedTo_ID
		WHERE (COALESCE($P{AD_CLIENT_ID}, $P{AD_Client_ID}) IS NULL 
		       OR COALESCE($P{AD_CLIENT_ID}, $P{AD_Client_ID}) = 0 
		       OR r.AD_Client_ID = COALESCE($P{AD_CLIENT_ID}, $P{AD_Client_ID}))
		  AND (CAST($P{Priority} AS varchar) IS NULL OR CAST($P{Priority} AS varchar) = '' OR r.Priority = $P{Priority})
		  AND (CAST($P{Status} AS varchar) IS NULL OR CAST($P{Status} AS varchar) = '' OR r.Status = $P{Status})
		  AND (CAST($P{RequestType} AS varchar) IS NULL OR CAST($P{RequestType} AS varchar) = '' OR r.RequestType = $P{RequestType})
		  AND (CAST($P{AssignedTo_ID} AS integer) IS NULL OR CAST($P{AssignedTo_ID} AS integer) = 0 OR r.AssignedTo_ID = $P{AssignedTo_ID})
		  AND (CAST($P{DateRequested1} AS timestamp) IS NULL OR r.DateRequested >= CAST($P{DateRequested1} AS timestamp))
		  AND (CAST($P{DateRequested2} AS timestamp) IS NULL OR r.DateRequested <= CAST($P{DateRequested2} AS timestamp))
		ORDER BY 
		    priority_name ASC,
		    r.DateRequested DESC
		]]>
	</queryString>

	<!-- Campos Mapeados -->
	<field name="xx_internalrequest_id" class="java.lang.Integer"/>
	<field name="documentno" class="java.lang.String"/>
	<field name="daterequested" class="java.sql.Timestamp"/>
